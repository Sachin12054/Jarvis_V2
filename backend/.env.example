# Application Configuration
APP_NAME=JARVIS
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database Settings
DATABASE_URL=postgresql+asyncpg://jarvis_user:jarvis_password@localhost:5432/jarvis_db

# LLM Provider Configuration
LLM_PROVIDER=ollama
LLM_MODEL=qwen3-test:latest
LLM_TIMEOUT=60.0

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-test:latest
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_TIMEOUT=300.0

# CUA Driver Settings
CUA_DRIVER_PATH=C:\Users\sachi\AppData\Local\Programs\Cua\cua-driver\bin\cua-driver.exe
CUA_SOCKET_PIPE=\\.\pipe\cua-driver
CUA_DRIVER_TIMEOUT=15.0

# Local Voice Settings (STT & TTS)
JARVIS_STT_PROVIDER=local_whisper
JARVIS_STT_MODEL=tiny
TTS_PROVIDER=kokoro
KOKORO_MODEL=Kokoro-82M
KOKORO_VOICE=am_adam
